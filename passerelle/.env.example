# ============================================================================
#  Passerelle : réglages. Copie ce fichier en .env (installer.sh le fait pour toi
#  et remplit tout seul les mots de passe aléatoires).
#  Ne partage JAMAIS ce fichier : il contient tes secrets.
# ============================================================================

# ---------------------------------------------------------------- ton domaine
# Le hub est sur https://DOMAINE, Authentik sur https://auth.DOMAINE,
# et chaque site sur https://<sous-domaine>.DOMAINE
DOMAINE=super-nono.cc
NOM_SITE=Super Nono
TZ=Europe/Paris

# ---------------------------------------------------------------- ton compte
# Créé au premier lancement (administrateur). Mets l'adresse de ton compte Google
# pour pouvoir aussi entrer avec Google.
ADMIN_EMAIL=
ADMIN_NOM=Noë

# ---------------------------------------------------------------- Cloudflare
# Le jeton du tunnel (Zero Trust → Networks → Tunnels → ton tunnel → « Install connector » :
# la longue valeur après « --token »).
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------- Google (facultatif)
# Google Cloud Console → Identifiants → ID client OAuth (application Web).
# URI de redirection autorisée : https://auth.DOMAINE/source/oauth/callback/google/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- e-mails (Brevo)
# Brevo → SMTP & API → onglet SMTP. L'adresse d'envoi doit être sur un domaine validé.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Super Nono <acces@super-nono.cc>
SMTP_TLS=true
SMTP_SSL=false

# ---------------------------------------------------------------- BotPanel
# Adresse de BotPanel vue depuis la passerelle (réseau local), sans / à la fin.
BOTPANEL_URL=http://192.168.1.50:8080
# Slug de la notification « nouvelle demande d'accès » créée dans BotPanel.
BOTPANEL_SLUG_DEMANDE=hub_demande
# BotPanel → Paramètres → Intégrations → « Secret webhook » (signature des boutons).
BOTPANEL_WEBHOOK_SECRET=

# ---------------------------------------------------------------- réglages fins
# Groupe Authentik des administrateurs du hub, et des membres acceptés.
GROUPE_ADMINS=authentik Admins
GROUPE_MEMBRES=Membres
# Durée d'une connexion avant de devoir se reconnecter.
DUREE_SESSION=days=30
# Durée de validité du lien d'invitation (jours).
INVITATION_JOURS=7

# ---------------------------------------------------------------- secrets (générés par installer.sh)
PG_PASS=
AUTHENTIK_SECRET_KEY=
# Jeton administrateur de démarrage : sert à configurer Authentik (hub.configurer).
AUTHENTIK_BOOTSTRAP_TOKEN=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_EMAIL=
# En-tête secret ajouté par Authentik à chaque requête connectée (X-Passerelle-Cle).
# Les sites peuvent le vérifier : voir docs/migrer-un-site.md.
PASSERELLE_CLE=
HUB_SECRET=
